# =====================================================================
# SPACE DESIGN — environment reference
# ---------------------------------------------------------------------
# This is a STATIC website. Browsers cannot read .env files, so these
# values are NOT loaded automatically. Copy the two PUBLIC values into
# js/config.js (SUPABASE_URL, SUPABASE_ANON_KEY) before deploying.
#
# Never commit a real .env file. Never put secrets in js/config.js.
# =====================================================================

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "anon" / "publishable" key.
# Safe to expose in the browser: access is enforced by Row Level Security.
SUPABASE_ANON_KEY=your-anon-public-key

# Production origin (no trailing slash). Also used in canonical URLs,
# sitemap.xml and robots.txt; replace "https://your-domain.com" there.
SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------
# DO NOT PUT THESE IN ANY FRONTEND FILE:
#   SUPABASE_SERVICE_ROLE_KEY / secret key  → bypasses RLS; server-side only
#   Database password                        → dashboard / CLI only
# The website never needs them.
# ---------------------------------------------------------------------
